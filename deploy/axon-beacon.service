[Unit]
Description=AXON Sovereign Cooperation Beacon
After=network-online.target postfix.service
Wants=network-online.target

[Service]
Type=simple
User=axon-beacon
Group=axon-beacon
WorkingDirectory=/opt/axon-beacon
EnvironmentFile=/etc/axon-beacon.env
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 127.0.0.1 --port 8094 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/axon-beacon
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
